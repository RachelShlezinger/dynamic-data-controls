{
  "ConnectionStrings": {
    "SystemDb": "Server=(localdb)\\MSSQLLocalDB;Database=DynamicDataControls_System;Trusted_Connection=True;TrustServerCertificate=True;",
    "TargetDb":  "Server=(localdb)\\MSSQLLocalDB;Database=DynamicDataControls_Target;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "DynamicDataControls",
    "Audience": "DynamicDataControls",
    "ExpiryHours": 8
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
